{
  "schemaVersion": "1.0",
  "id": "screenshot",
  "packageId": "screenshot",
  "displayName": "截图",
  "version": "0.1.0",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "inproc-dotnet",
      "priority": 100,
      "platforms": [
        "windows-x64",
        "windows-arm64",
        "linux-x64",
        "linux-arm64",
        "macos-arm64",
        "macos-x64"
      ],
      "assembly": "Screenshot.MyPowerTools.dll",
      "type": "Screenshot.MyPowerTools.ScreenshotModule"
    }
  ],
  "capabilities": [
    "lifecycle",
    "status",
    "commands",
    "settings",
    "logs",
    "dashboardCard",
    "detailPage"
  ],
  "runtimePolicy": {
    "preferred": "inproc",
    "allowInProc": true,
    "inProcRules": {
      "maxCallMs": 10000,
      "allowNativeDll": false,
      "allowWindow": false,
      "allowBackgroundThreads": true,
      "loadContext": "collectible",
      "shadowCopy": true
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "inproc-or-sidecar",
      "systemMutation": "broker-required",
      "nativeHardware": "inproc-or-sidecar",
      "elevatedWrite": "broker-required",
      "externalProcess": "inproc-or-sidecar"
    }
  },
  "requires": [],
  "permissions": [],
  "hotkeys": [],
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "tools": ["ui/tool.json"],
  "uiSurfaces": [
    "ui/dashboard-card.json",
    "ui/detail-page.json",
    "ui/settings.json",
    "ui/logs.json"
  ]
}
