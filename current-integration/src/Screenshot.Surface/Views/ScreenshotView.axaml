<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:Screenshot.Surface.ViewModels"
             x:Class="Screenshot.Surface.Views.ScreenshotView"
             x:DataType="vm:ScreenshotViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource MptBrushTextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <Border Padding="40,24,40,40" HorizontalAlignment="Stretch" VerticalAlignment="Top">
    <StackPanel Spacing="16" MaxWidth="1100">
      <Border Background="{DynamicResource MptBrushInfoBackground}"
              BorderBrush="{DynamicResource MptBrushInfo}"
              BorderThickness="1"
              CornerRadius="{DynamicResource MptRadiusCard}"
              Padding="24,20">
        <StackPanel Spacing="6">
          <TextBlock Text="截图" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Classes="secondary"
                     MaxWidth="760"
                     Text="选择快咔、Snow Shot 或 Flameshot 完成截图，也可以在这里压缩任意来源的本地图片。" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
        <Border Classes="card" MinHeight="132">
          <StackPanel Spacing="8">
            <TextBlock Text="当前程序" Classes="secondary" />
            <TextBlock Text="{Binding Backend}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Executable}" Classes="secondary" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card" MinHeight="132">
          <StackPanel Spacing="8">
            <TextBlock Text="进程" Classes="secondary" />
            <TextBlock Text="{Binding Running}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding HotkeyNote}" Classes="secondary" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <controls:MptButton Classes="MptPrimaryButton" Content="立即截图" Command="{Binding CaptureCommand}" />
        <controls:MptButton Content="打开截图工具" Command="{Binding OpenCommand}" />
        <controls:MptButton Content="刷新" Command="{Binding RefreshCommand}" />
      </StackPanel>

      <Border Classes="card" IsVisible="{Binding ShowInstallHint}">
        <StackPanel Spacing="6">
          <TextBlock Text="还没有安装截图程序" Classes="section-title" />
          <TextBlock Text="{Binding InstallHint}" Classes="secondary" />
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanInstall}">
            <controls:MptButton Classes="MptPrimaryButton" Content="下载并安装 Snow Shot" Command="{Binding InstallCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding InstallStatus}" Classes="secondary" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource MptBrushSurfaceRaised}"
              BorderBrush="{DynamicResource MptBrushBorder}"
              BorderThickness="1"
              CornerRadius="{DynamicResource MptRadiusControl}"
              Padding="16,12">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="设置" Classes="section-title" />
          <TextBlock Classes="secondary"
                     Text="选择程序后保存设置。路径留空时自动查找；便携版可填写可执行文件的绝对路径，macOS 可填写应用 .app 路径。" />
          <ComboBox ItemsSource="{Binding BackendChoices}" SelectedIndex="{Binding SelectedBackendIndex}" HorizontalAlignment="Stretch" />
          <controls:MptButton Content="打开快咔官网下载" Click="KuaikaDownload_Click" IsVisible="{Binding IsKuaikaSelected}" />
          <StackPanel Spacing="6">
            <TextBlock Text="截图程序路径" />
            <controls:MptTextBox Text="{Binding ExecutablePath}" PlaceholderText="留空则自动查找" />
          </StackPanel>
          <controls:MptCheckBox Content="随 MyPowerTools 启动"
                                IsChecked="{Binding LaunchWithMyPowerTools}" />
          <TextBlock Classes="secondary"
                     Text="关闭这项只停止这次由 MyPowerTools 拉起的进程。截图快捷键以所选程序的设置为准。" />
          <controls:MptButton Content="保存设置" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="图片压缩" Classes="section-title" />
          <TextBlock Classes="secondary" Text="支持多选 PNG、JPEG、WebP、BMP；在本机处理并另存副本。WebP 支持透明背景，JPEG 将透明区域填为白色。PNG 使用无损编码，质量值仅影响 WebP 和 JPEG。" />
          <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="12" IsEnabled="{Binding !IsCompressing}">
            <StackPanel Spacing="6">
              <TextBlock Text="输出格式" />
              <ComboBox ItemsSource="{Binding CompressionFormats}" SelectedIndex="{Binding CompressionFormatIndex}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="质量（1–100）" />
              <NumericUpDown Value="{Binding CompressionQuality}" Minimum="1" Maximum="100" Increment="1" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
              <TextBlock Text="最长边（像素，0 保持尺寸）" />
              <NumericUpDown Value="{Binding CompressionMaximumEdge}" Minimum="0" Maximum="16384" Increment="100" FormatString="0" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:MptButton Classes="MptPrimaryButton" Content="选择图片并压缩" Click="Compress_Click" IsEnabled="{Binding !IsCompressing}" />
            <controls:MptButton Content="取消" Click="CancelCompression_Click" IsVisible="{Binding IsCompressing}" />
          </StackPanel>
          <SelectableTextBlock Text="{Binding CompressionResults}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
